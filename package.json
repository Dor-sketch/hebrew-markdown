{
  "name": "hebrew-markdown",
  "version": "1.0.0",
  "description": "Hebrew Markdown Editor - RTL Markdown editor with live preview",
  "main": "electron/main.js",
  "author": "Dor Pascal",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack:win": "electron-builder --win portable",
    "pack:linux": "electron-builder --linux AppImage",
    "pack:mac": "electron-builder --mac dmg",
    "prestart": "node electron/prepare-assets.js",
    "prepack:win": "node electron/prepare-assets.js",
    "prepack:linux": "node electron/prepare-assets.js",
    "prepack:mac": "node electron/prepare-assets.js"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "6.5.1",
    "codemirror": "5.65.13",
    "dompurify": "3.4.18",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "katex": "0.19.1",
    "marked": "4.3.0",
    "mermaid": "12.3.0"
  },
  "build": {
    "appId": "com.dorpascal.hebrew-markdown",
    "productName": "Hebrew Markdown",
    "files": [
      "index.electron.html",
      "editor.js",
      "styles.css",
      "desktop-vendor/**/*",
      "images/icon.svg",
      "electron/main.js",
      "electron/preload.js"
    ],
    "win": {
      "target": "portable",
      "icon": "images/icon.svg"
    },
    "linux": {
      "target": "AppImage",
      "icon": "images/icon.svg",
      "category": "Office"
    },
    "mac": {
      "target": "dmg",
      "icon": "images/icon.svg",
      "category": "public.app-category.productivity"
    },
    "portable": {
      "artifactName": "HebrewMarkdown-Portable.exe"
    }
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  }
}
